# Copy to .env.local (gitignored) and fill in. One shared Supabase project is fine for the whole team.

# Server only (secret key bypasses RLS; never NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Browser (publishable key; used only for the Realtime subscription on session_ticks)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Agents
ANTHROPIC_API_KEY=sk-ant-...

# Used for the join QR code and the simulator
NEXT_PUBLIC_APP_URL=http://localhost:3000
